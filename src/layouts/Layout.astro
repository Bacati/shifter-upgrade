---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Générateur de licences Aptatio Racing" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-gray-950 text-gray-100 min-h-screen font-sans selection:bg-primary-500 selection:text-white">
		<main class="container max-w-2xl mx-auto py-12 flex flex-col min-h-screen justify-center">
			<slot />
		</main>
	</body>
</html>